@model ActionFormModel
@using Factorio.Domain.Enums

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<input type="hidden" asp-for="Id" />

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="UserId" class="form-label"></label>
        <select asp-for="UserId" asp-items="Model.UserOptions" class="form-select">
            <option value="">(choose)</option>
        </select>
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ItemId" class="form-label"></label>
        <select asp-for="ItemId" asp-items="Model.ItemOptions" class="form-select">
            <option value="">(choose)</option>
        </select>
        <span asp-validation-for="ItemId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<ActionType>()" class="form-select"></select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Details" class="form-label"></label>
        <textarea asp-for="Details" rows="4" class="form-control"></textarea>
        <span asp-validation-for="Details" class="text-danger"></span>
    </div>
</div>
