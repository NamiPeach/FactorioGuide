@model Factorio.Domain.Entities.User
@{
    ViewData["Title"] = "Delete user";
}
<h1 class="h3 mb-3">Delete user</h1>

<div class="alert alert-warning" style="max-width: 480px;">
    Are you sure you want to delete <strong>@Model.Name</strong> (@Model.Email)?
    This cannot be undone.
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
