<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - FactorioGuide Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">FactorioGuide</a>
        <ul class="navbar-nav me-auto">
            <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
            <li class="nav-item"><a class="nav-link" asp-controller="Items" asp-action="Index">Items</a></li>
        </ul>
        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-flex">
            <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
        </form>
    </div>
</nav>
<div class="container py-4">
    @RenderBody()
</div>
</body>
</html>
