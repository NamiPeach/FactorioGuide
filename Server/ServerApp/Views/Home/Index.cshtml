@{
    ViewData["Title"] = "Dashboard";
}
<h1 class="h3 mb-3">FactorioGuide admin panel</h1>

<div class="alert alert-success">
    You are signed in as <strong>@User.Identity?.Name</strong>.
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Users</h2>
                <p class="text-muted">Registered users of the app.</p>
                <a asp-controller="Users" asp-action="Index" class="btn btn-primary">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Items</h2>
                <p class="text-muted">Factorio items and buildings.</p>
                <a asp-controller="Items" asp-action="Index" class="btn btn-primary">Open</a>
            </div>
        </div>
    </div>
</div>
