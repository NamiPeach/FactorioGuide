@model IEnumerable<Factorio.Domain.Entities.Item>
@{
    ViewData["Title"] = "Items";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Items</h1>
    <a asp-action="Create" class="btn btn-primary">Create item</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="q" value="@ViewData["Query"]" class="form-control" placeholder="Name, internal name or category" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-action="Index" class="btn btn-link">Reset</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Internal name</th>
            <th>Category</th>
            <th>Stack</th>
            <th>Craft time</th>
            <th>Last edited by</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td><code>@item.InternalName</code></td>
            <td>@item.Category</td>
            <td>@item.StackSize</td>
            <td>@item.CraftTime</td>
            <td>@(item.User?.Name ?? "-")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
<p class="text-muted">Total: @Model.Count()</p>
